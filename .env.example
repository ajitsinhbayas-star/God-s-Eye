# ==============================================================================
# GOD'S EYE SPACE OBSERVATORY — ENVIRONMENT SPECIFICATION & DEPLOYMENT CONFIG
# ==============================================================================

# Server Network Configuration (Render automatically assigns PORT)
PORT=3000
NODE_ENV=production
DEV_SECRET=change_this_to_a_secure_diagnostic_token_32chars

# Sentinel Administration Console (Mandatory for Operations Lock)
SENTINEL_ADMIN_USERNAME=admin
SENTINEL_ADMIN_PASSWORD=change_this_to_a_strong_password_min8chars
SENTINEL_SESSION_SECRET=change_this_to_a_high_entropy_secret_32bytes_hex

# NASA / JPL / Open Data APIs (Default DEMO_KEY works for general traffic)
NASA_API_KEY=DEMO_KEY

# Optional: Real-Time NASA FIRMS Global Active Wildfire Satellite CSVs
# Obtain free map key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional: Google Gemini AI Assistant Key for J.A.R.V.I.S.
# When omitted, J.A.R.V.I.S. operates on deterministic telemetry lookup engine
GEMINI_API_KEY=

# Optional: SatNOGS Amateur Satellite Transmitter Database Token
# https://network.satnogs.org/users/api-tokens/ & https://db.satnogs.org
SATNOGS_USERNAME=
SATNOGS_PASSWORD=
SATNOGS_API_TOKEN=
SATNOGS_API_KEY=

# Optional: Official 18th Space Defense Squadron Space-Track.org Credentials
SPACE_TRACK_USER=
SPACE_TRACK_PASSWORD=

# Optional: ESA DISCOSweb Space Debris Database API Token
# Institutional registration at: https://discosweb.esoc.esa.int
ESA_DISCOS_TOKEN=
DISCOSWEB_API_TOKEN=

# Optional Commercial SSA Gateways (Leave empty if not contracted)
LEOLABS_API_KEY=
SLINGSHOT_API_KEY=
COMSPOC_API_KEY=

# Optional: OpenAQ Global Air Quality Hub v3 API Key
# Obtain at: https://openaq.org
OPENAQ_API_KEY=

# Storage Architecture Notice:
# Render web services use ephemeral local filesystems on free tiers.
# Local SQLite (data/sentinel_command.db) and JSON cache (data/space-db.json)
# re-initialize automatically from bundled assets on container restart.
# To persist user watchlists or audit logs permanently across Render redeploys,
# attach a Render Persistent Disk mounted at /opt/render/project/src/data or use a managed DB.
